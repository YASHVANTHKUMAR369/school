<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- A guardian can only read their own guardian record. -->
        <record id="ir_rule_portal_guardian_own" model="ir.rule">
            <field name="name">Portal: guardian sees only own record</field>
            <field name="model_id" ref="school_core.model_school_guardian"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- A guardian can only see their own children. -->
        <record id="ir_rule_portal_student_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees only own children</field>
            <field name="model_id" ref="school_admission.model_school_student"/>
            <field name="domain_force">[('guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_attendance_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees attendance of own children</field>
            <field name="model_id" ref="school_attendance.model_school_student_attendance"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_timetable_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees timetable of own children's sections</field>
            <field name="model_id" ref="school_academics.model_school_timetable_slot"/>
            <field name="domain_force">[('section_id.student_ids.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_homework_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees homework of own children's sections</field>
            <field name="model_id" ref="school_academics.model_school_homework"/>
            <field name="domain_force">[('section_id.student_ids.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_homework_submission_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees/submits homework of own children</field>
            <field name="model_id" ref="school_academics.model_school_homework_submission"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_exam_result_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees published exam results of own children</field>
            <field name="model_id" ref="school_exam.model_school_exam_result"/>
            <field name="domain_force">
                [('student_id.guardian_ids.user_id', '=', user.id), ('exam_id.state', '=', 'results_published')]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_report_card_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees published report cards of own children</field>
            <field name="model_id" ref="school_exam.model_school_report_card"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id), ('state', '=', 'published')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_fee_invoice_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees fee invoices of own children</field>
            <field name="model_id" ref="school_fees.model_school_fee_invoice"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_fee_payment_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees fee payments of own children</field>
            <field name="model_id" ref="school_fees.model_school_fee_payment"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_transport_allocation_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees transport allocation of own children</field>
            <field name="model_id" ref="school_transport.model_school_transport_allocation"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_hostel_allocation_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees hostel allocation of own children</field>
            <field name="model_id" ref="school_hostel.model_school_hostel_allocation"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_library_member_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees library membership of own children</field>
            <field name="model_id" ref="school_library.model_school_library_member"/>
            <field name="domain_force">[('student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_library_circulation_own_children" model="ir.rule">
            <field name="name">Portal: guardian sees library circulation of own children</field>
            <field name="model_id" ref="school_library.model_school_library_circulation"/>
            <field name="domain_force">[('member_id.student_id.guardian_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="ir_rule_portal_notice_visible" model="ir.rule">
            <field name="name">Portal: guardian sees notices addressed to them</field>
            <field name="model_id" ref="school_communication.model_school_notice"/>
            <field name="domain_force">
                ['|', '|', '|',
                    ('audience_type', '=', 'all'),
                    '&amp;', ('audience_type', '=', 'standard'), ('standard_ids.section_ids.student_ids.guardian_ids.user_id', '=', user.id),
                    '&amp;', ('audience_type', '=', 'section'), ('section_ids.student_ids.guardian_ids.user_id', '=', user.id),
                    '&amp;', ('audience_type', '=', 'individual_student'), ('student_ids.guardian_ids.user_id', '=', user.id),
                ]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
