<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_library_book_list" model="ir.ui.view">
        <field name="name">school.library.book.list</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="author"/>
                <field name="category_id"/>
                <field name="total_copies"/>
                <field name="available_copies"/>
            </list>
        </field>
    </record>

    <record id="view_school_library_book_form" model="ir.ui.view">
        <field name="name">school.library.book.form</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="author"/>
                            <field name="isbn"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="publisher"/>
                            <field name="edition"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Copies">
                            <field name="copy_ids">
                                <list editable="bottom">
                                    <field name="accession_no"/>
                                    <field name="barcode"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">school.library.book</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
