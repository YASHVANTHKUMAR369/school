<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_library_circulation_list" model="ir.ui.view">
        <field name="name">school.library.circulation.list</field>
        <field name="model">school.library.circulation</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'overdue'" decoration-success="state == 'returned'">
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="issue_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="fine_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_library_circulation_form" model="ir.ui.view">
        <field name="name">school.library.circulation.form</field>
        <field name="model">school.library.circulation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_return" string="Return" type="object"
                            class="oe_highlight" invisible="state != 'issued'"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object"
                            invisible="state not in ('issued',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="book_copy_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="due_date"/>
                            <field name="return_date"/>
                            <field name="fine_per_day"/>
                            <field name="fine_amount" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_library_circulation" model="ir.actions.act_window">
        <field name="name">Circulation</field>
        <field name="res_model">school.library.circulation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
