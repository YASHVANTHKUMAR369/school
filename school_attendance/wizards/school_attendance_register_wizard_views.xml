<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_attendance_register_wizard_form" model="ir.ui.view">
        <field name="name">school.attendance.register.wizard.form</field>
        <field name="model">school.attendance.register.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="section_id"/>
                    <field name="date"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="student_id" readonly="1"/>
                        <field name="state" widget="radio" options="{'horizontal': true}"/>
                        <field name="remark"/>
                    </list>
                </field>
                <footer>
                    <button name="action_save" string="Save Attendance" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_attendance_register_wizard" model="ir.actions.act_window">
        <field name="name">Mark Attendance</field>
        <field name="res_model">school.attendance.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
