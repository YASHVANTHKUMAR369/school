<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_student_attendance_list" model="ir.ui.view">
        <field name="name">school.student.attendance.list</field>
        <field name="model">school.student.attendance</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'absent'" decoration-success="state == 'present'">
                <field name="date"/>
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="state" widget="badge"/>
                <field name="remark"/>
            </list>
        </field>
    </record>

    <record id="view_school_student_attendance_search" model="ir.ui.view">
        <field name="name">school.student.attendance.search</field>
        <field name="model">school.student.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="date"/>
                <group>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_student_attendance" model="ir.actions.act_window">
        <field name="name">Student Attendance</field>
        <field name="res_model">school.student.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
