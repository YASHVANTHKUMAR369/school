<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_staff_attendance_list" model="ir.ui.view">
        <field name="name">school.staff.attendance.list</field>
        <field name="model">school.staff.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="staff_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_school_staff_attendance" model="ir.actions.act_window">
        <field name="name">Staff Attendance</field>
        <field name="res_model">school.staff.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
