<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_hostel_allocation_list" model="ir.ui.view">
        <field name="name">school.hostel.allocation.list</field>
        <field name="model">school.hostel.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="hostel_id"/>
                <field name="room_id"/>
                <field name="bed_id"/>
                <field name="date_from"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_hostel_allocation_form" model="ir.ui.view">
        <field name="name">school.hostel.allocation.form</field>
        <field name="model">school.hostel.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_vacate" string="Vacate" type="object" invisible="state != 'active'"/>
                    <button name="action_activate" string="Reactivate" type="object" invisible="state != 'vacated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,vacated"/>
                </header>
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="hostel_id"/>
                        <field name="room_id"/>
                        <field name="bed_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_hostel_allocation" model="ir.actions.act_window">
        <field name="name">Hostel Allocation</field>
        <field name="res_model">school.hostel.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
