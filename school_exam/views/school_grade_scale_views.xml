<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_grade_scale_form" model="ir.ui.view">
        <field name="name">school.grade.scale.form</field>
        <field name="model">school.grade.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="grade"/>
                            <field name="min_percent"/>
                            <field name="max_percent"/>
                            <field name="grade_point"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_grade_scale_list" model="ir.ui.view">
        <field name="name">school.grade.scale.list</field>
        <field name="model">school.grade.scale</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_school_grade_scale" model="ir.actions.act_window">
        <field name="name">Grade Scales</field>
        <field name="res_model">school.grade.scale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
