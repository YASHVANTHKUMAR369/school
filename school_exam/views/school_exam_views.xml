<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_exam_list" model="ir.ui.view">
        <field name="name">school.exam.list</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exam_type_id"/>
                <field name="standard_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_exam_form" model="ir.ui.view">
        <field name="name">school.exam.form</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" string="Schedule" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start" type="object"
                            invisible="state != 'scheduled'"/>
                    <button name="action_complete" string="Mark Completed" type="object"
                            invisible="state != 'ongoing'"/>
                    <button name="action_publish_results" string="Publish Results" type="object"
                            class="oe_highlight" invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,ongoing,completed,results_published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Exam Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="exam_type_id"/>
                            <field name="academic_year_id"/>
                            <field name="standard_id"/>
                            <field name="section_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="grade_scale_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subject Schedule">
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="date"/>
                                    <field name="time_from" widget="float_time"/>
                                    <field name="time_to" widget="float_time"/>
                                    <field name="max_marks"/>
                                    <field name="passing_marks"/>
                                    <field name="room_no"/>
                                </list>
                            </field>
                        </page>
                        <page string="Results">
                            <field name="result_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="schedule_id"/>
                                    <field name="max_marks" readonly="1"/>
                                    <field name="marks_obtained"/>
                                    <field name="is_absent"/>
                                    <field name="percentage" readonly="1"/>
                                    <field name="grade" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_exam" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">school.exam</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
