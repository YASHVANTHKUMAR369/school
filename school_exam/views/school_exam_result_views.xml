<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_exam_result_list" model="ir.ui.view">
        <field name="name">school.exam.result.list</field>
        <field name="model">school.exam.result</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="exam_id"/>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="max_marks"/>
                <field name="marks_obtained"/>
                <field name="is_absent"/>
                <field name="percentage"/>
                <field name="grade"/>
            </list>
        </field>
    </record>

    <record id="action_school_exam_result" model="ir.actions.act_window">
        <field name="name">Marks Entry</field>
        <field name="res_model">school.exam.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
