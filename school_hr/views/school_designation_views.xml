<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_designation_list" model="ir.ui.view">
        <field name="name">school.designation.list</field>
        <field name="model">school.designation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <record id="action_school_designation" model="ir.actions.act_window">
        <field name="name">Designations</field>
        <field name="res_model">school.designation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
