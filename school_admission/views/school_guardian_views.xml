<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_guardian_form_inherit_admission" model="ir.ui.view">
        <field name="name">school.guardian.form.inherit.admission</field>
        <field name="model">school.guardian</field>
        <field name="inherit_id" ref="school_core.view_school_guardian_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Children">
                        <field name="student_ids" widget="many2many_tags"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
