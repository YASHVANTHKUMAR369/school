<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_school_admission_enquiry" model="ir.sequence">
        <field name="name">Admission Enquiry</field>
        <field name="code">school.admission.enquiry</field>
        <field name="prefix">ENQ</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_school_admission_application" model="ir.sequence">
        <field name="name">Admission Application</field>
        <field name="code">school.admission.application</field>
        <field name="prefix">APP</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_school_student_admission_no" model="ir.sequence">
        <field name="name">Student Admission Number</field>
        <field name="code">school.student.admission.no</field>
        <field name="prefix">ADM%(year)s</field>
        <field name="padding">4</field>
    </record>
</odoo>
