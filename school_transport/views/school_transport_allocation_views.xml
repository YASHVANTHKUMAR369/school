<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_transport_allocation_list" model="ir.ui.view">
        <field name="name">school.transport.allocation.list</field>
        <field name="model">school.transport.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="route_id"/>
                <field name="stop_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_school_transport_allocation" model="ir.actions.act_window">
        <field name="name">Transport Allocation</field>
        <field name="res_model">school.transport.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
