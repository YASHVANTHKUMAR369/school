<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_transport_driver_list" model="ir.ui.view">
        <field name="name">school.transport.driver.list</field>
        <field name="model">school.transport.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="license_no"/>
                <field name="license_expiry"/>
                <field name="mobile"/>
            </list>
        </field>
    </record>

    <record id="action_school_transport_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">school.transport.driver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
