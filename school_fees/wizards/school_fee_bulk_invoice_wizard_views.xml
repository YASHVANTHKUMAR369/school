<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_bulk_invoice_wizard_form" model="ir.ui.view">
        <field name="name">school.fee.bulk.invoice.wizard.form</field>
        <field name="model">school.fee.bulk.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="structure_id"/>
                    <field name="due_date"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate Invoices" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_fee_bulk_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Generate Invoices</field>
        <field name="res_model">school.fee.bulk.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
