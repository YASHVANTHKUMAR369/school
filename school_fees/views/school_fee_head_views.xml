<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_head_list" model="ir.ui.view">
        <field name="name">school.fee.head.list</field>
        <field name="model">school.fee.head</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="is_recurring"/>
            </list>
        </field>
    </record>

    <record id="action_school_fee_head" model="ir.actions.act_window">
        <field name="name">Fee Heads</field>
        <field name="res_model">school.fee.head</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
