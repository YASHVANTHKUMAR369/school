<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_invoice_list" model="ir.ui.view">
        <field name="name">school.fee.invoice.list</field>
        <field name="model">school.fee.invoice</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'overdue'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="total_amount"/>
                <field name="amount_paid"/>
                <field name="amount_due"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_fee_invoice_form" model="ir.ui.view">
        <field name="name">school.fee.invoice.form</field>
        <field name="model">school.fee.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" string="Post" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled', 'paid')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted,partially_paid,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="late_fee_rule_id"/>
                            <field name="late_fee_amount" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="fee_head_id"/>
                            <field name="amount"/>
                            <field name="discount"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_amount" readonly="1"/>
                        <field name="amount_paid" readonly="1"/>
                        <field name="amount_due" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="payment_date"/>
                                    <field name="amount"/>
                                    <field name="payment_mode"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_fee_invoice" model="ir.actions.act_window">
        <field name="name">Fee Invoices</field>
        <field name="res_model">school.fee.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
