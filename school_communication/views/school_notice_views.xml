<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_notice_list" model="ir.ui.view">
        <field name="name">school.notice.list</field>
        <field name="model">school.notice</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'archived'">
                <field name="title"/>
                <field name="notice_date"/>
                <field name="audience_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_notice_form" model="ir.ui.view">
        <field name="name">school.notice.form</field>
        <field name="model">school.notice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_archive_notice" string="Archive" type="object"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Notice Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="notice_date"/>
                            <field name="expiry_date"/>
                            <field name="audience_type"/>
                        </group>
                        <group>
                            <field name="standard_ids" widget="many2many_tags"
                                   invisible="audience_type != 'standard'"/>
                            <field name="section_ids" widget="many2many_tags"
                                   invisible="audience_type != 'section'"/>
                            <field name="student_ids" widget="many2many_tags"
                                   invisible="audience_type != 'individual_student'"/>
                            <field name="staff_ids" widget="many2many_tags"
                                   invisible="audience_type != 'individual_staff'"/>
                            <field name="send_email"/>
                            <field name="send_sms"/>
                        </group>
                    </group>
                    <field name="body" placeholder="Notice content..."/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <notebook>
                        <page string="Dispatch Log">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="channel"/>
                                    <field name="recipient_partner_id"/>
                                    <field name="recipient_mobile"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_notice" model="ir.actions.act_window">
        <field name="name">Notices</field>
        <field name="res_model">school.notice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
