<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_config_form" model="ir.ui.view">
        <field name="name">school.config.form</field>
        <field name="model">school.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="udise_code"/>
                            <field name="affiliation_no"/>
                            <field name="principal_name"/>
                        </group>
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="principal_signature" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_config_list" model="ir.ui.view">
        <field name="name">school.config.list</field>
        <field name="model">school.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="udise_code"/>
                <field name="affiliation_no"/>
            </list>
        </field>
    </record>

    <record id="action_school_config" model="ir.actions.act_window">
        <field name="name">School Settings</field>
        <field name="res_model">school.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
