<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_board_list" model="ir.ui.view">
        <field name="name">school.board.list</field>
        <field name="model">school.board</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="affiliation_no"/>
            </list>
        </field>
    </record>

    <record id="action_school_board" model="ir.actions.act_window">
        <field name="name">Boards</field>
        <field name="res_model">school.board</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
