<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_school_transfer_certificate_document">
        <t t-call="web.html_container">
            <t t-set="school_config" t-value="env['school.config'].get_config()"/>
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="text-center mb-4">
                        <img t-if="school_config.logo" t-att-src="image_data_uri(school_config.logo)"
                             style="max-height: 80px;"/>
                        <h2 t-out="school_config.name"/>
                        <div t-out="school_config.address"/>
                        <div t-if="school_config.affiliation_no">
                            Affiliation No: <span t-out="school_config.affiliation_no"/>
                        </div>
                        <h3>Transfer Certificate</h3>
                        <div>Certificate No: <span t-out="o.certificate_no"/></div>
                    </div>
                    <table class="table table-sm">
                        <tr><td style="width:50%;">Student Name</td><td t-out="o.student_id.name"/></tr>
                        <tr><td>Admission Number</td><td t-out="o.student_id.admission_no"/></tr>
                        <tr><td>Father's / Mother's Name</td>
                            <td t-out="o.student_id.primary_guardian_id.name"/></tr>
                        <tr><td>Date of Birth</td><td t-out="o.student_id.dob"/></tr>
                        <tr><td>Nationality</td><td t-out="o.student_id.nationality_id.name"/></tr>
                        <tr><td>Category</td><td t-out="o.student_id.category"/></tr>
                        <tr><td>Last Class Studied</td><td t-out="o.last_class_studied"/></tr>
                        <tr><td>Date of Admission</td><td t-out="o.student_id.admission_date"/></tr>
                        <tr><td>Date of Leaving</td><td t-out="o.date_of_leaving"/></tr>
                        <tr><td>Whole School Attendance %</td><td t-out="o.whole_school_attendance"/></tr>
                        <tr><td>Conduct</td><td t-out="o.conduct"/></tr>
                        <tr><td>Qualified for Promotion</td>
                            <td t-out="'Yes' if o.qualified_for_promotion else 'No'"/></tr>
                        <tr><td>Reason for Leaving</td><td t-out="o.reason"/></tr>
                    </table>
                    <div class="row mt-5">
                        <div class="col-6"/>
                        <div class="col-6 text-center">
                            <img t-if="school_config.principal_signature"
                                 t-att-src="image_data_uri(school_config.principal_signature)"
                                 style="max-height: 60px;"/>
                            <div>Principal: <span t-out="school_config.principal_name"/></div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
