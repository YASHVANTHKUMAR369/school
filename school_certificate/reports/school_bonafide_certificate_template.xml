<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_school_bonafide_certificate_document">
        <t t-call="web.html_container">
            <t t-set="school_config" t-value="env['school.config'].get_config()"/>
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="text-center mb-4">
                        <img t-if="school_config.logo" t-att-src="image_data_uri(school_config.logo)"
                             style="max-height: 80px;"/>
                        <h2 t-out="school_config.name"/>
                        <div t-out="school_config.address"/>
                        <h3>Bonafide Certificate</h3>
                        <div>Certificate No: <span t-out="o.certificate_no"/></div>
                    </div>
                    <p>
                        This is to certify that
                        <strong t-out="o.student_id.name"/>,
                        Admission No. <span t-out="o.student_id.admission_no"/>,
                        is a bonafide student of this school, studying in
                        <span t-out="o.student_id.standard_id.name"/> -
                        <span t-out="o.student_id.section_id.name"/>
                        during the academic year <span t-out="o.academic_year_id.name"/>.
                    </p>
                    <p>This certificate is issued on request for whatever purpose it may serve.</p>
                    <div class="row mt-5">
                        <div class="col-6"/>
                        <div class="col-6 text-center">
                            <img t-if="school_config.principal_signature"
                                 t-att-src="image_data_uri(school_config.principal_signature)"
                                 style="max-height: 60px;"/>
                            <div>Principal: <span t-out="school_config.principal_name"/></div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
