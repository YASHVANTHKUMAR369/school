<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_syllabus_topic_list" model="ir.ui.view">
        <field name="name">school.syllabus.topic.list</field>
        <field name="model">school.syllabus.topic</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="state == 'completed'">
                <field name="standard_id"/>
                <field name="subject_id"/>
                <field name="unit_name"/>
                <field name="topic_name"/>
                <field name="staff_id"/>
                <field name="planned_date"/>
                <field name="completed_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_school_syllabus_topic" model="ir.actions.act_window">
        <field name="name">Syllabus Tracker</field>
        <field name="res_model">school.syllabus.topic</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
