<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_homework_list" model="ir.ui.view">
        <field name="name">school.homework.list</field>
        <field name="model">school.homework</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="section_id"/>
                <field name="staff_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_homework_form" model="ir.ui.view">
        <field name="name">school.homework.form</field>
        <field name="model">school.homework</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Homework Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject_id"/>
                            <field name="section_id"/>
                            <field name="staff_id"/>
                        </group>
                        <group>
                            <field name="assign_date"/>
                            <field name="due_date"/>
                            <field name="submission_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Instructions..."/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <notebook>
                        <page string="Submissions">
                            <field name="submission_ids" readonly="1">
                                <list>
                                    <field name="student_id"/>
                                    <field name="submission_date"/>
                                    <field name="marks_obtained"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_homework" model="ir.actions.act_window">
        <field name="name">Homework</field>
        <field name="res_model">school.homework</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
